{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nirs4all-repository/project-submission/v1",
  "title": "Local project recipe submission",
  "description": "Wire shape only. Ordered semantic refusals and byte limits are specified in docs/PROJECT_SERVICE.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "nirs4all-repository/project-submission/v1"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relpath",
          "sha256",
          "content_base64"
        ],
        "properties": {
          "relpath": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "content_base64": {
            "type": "string"
          }
        }
      }
    }
  }
}
